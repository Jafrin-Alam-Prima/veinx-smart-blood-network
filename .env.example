# VeinX environment variables — copy to .env.local and fill in.

# Mapbox GL access token (https://account.mapbox.com/access-tokens/).
# IMPORTANT: this token ships to the browser. Before deploying publicly,
# restrict it to your domain (URL restrictions) in the Mapbox dashboard.
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_mapbox_token_here

# App
NEXT_PUBLIC_APP_NAME=VeinX

# Hackathon demo mode (enables scripted demo scenarios + map fallback).
NEXT_PUBLIC_DEMO_MODE=true
